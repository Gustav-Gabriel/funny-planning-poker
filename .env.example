# Chave da API KLIPY (opcional; busca de GIFs no avatar).
# Obtenha em https://klipy.com/developers
KLIPY_API_KEY=

# Chave beta gratuita da API Giphy (opcional; busca de GIFs no avatar).
# Obtenha em https://developers.giphy.com/dashboard/
# Limite tipico da beta: ~100 req/h.
GIPHY_API_KEY=

# Porta HTTP do servidor customizado (Next + Socket.io). Padrão: 3000.
PORT=3000
